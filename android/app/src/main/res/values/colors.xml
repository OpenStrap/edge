<resources>
    <color name="ic_launcher_background">#21351A</color>
    <!-- The window behind the app while the process starts and while Flutter
         draws its first frame. Same value as P.bg, so the handoff from the OS
         to lib/ui2 is a colour that does not change. The night/ copy is the
         dark one; the platform default (?android:colorBackground) was pure
         white and pure black, and pure black against the app's #0B1017 was a
         visible step on every cold start. -->
    <color name="launch_background">#F8FAFC</color>
</resources>