    "Buzz Band": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Band vibrieren lassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacer vibrar la banda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faire vibrer le bracelet"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैंड वाइब्रेट करें"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибрация браслета"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นสายรัด"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让手环振动"
          }
        }
      }
    },
    "Buzz your band once over Edge's existing connection. Nothing happens if Edge isn't connected to the band at that moment.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass dein Band einmal über die bestehende Verbindung von Edge vibrieren. Wenn Edge gerade nicht mit dem Band verbunden ist, passiert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz vibrar tu banda una vez a través de la conexión actual de Edge. No pasa nada si Edge no está conectado a la banda en ese momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites vibrer votre bracelet une fois via la connexion existante d'Edge. Rien ne se passe si Edge n'est pas connecté au bracelet à ce moment-là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge के मौजूदा कनेक्शन से अपना बैंड एक बार वाइब्रेट करें। अगर उस समय Edge बैंड से जुड़ा नहीं है तो कुछ नहीं होगा।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Браслет один раз завибрирует через текущее подключение Edge. Если Edge в этот момент не подключён к браслету, ничего не произойдёт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สั่นสายรัดหนึ่งครั้งผ่านการเชื่อมต่อที่ Edge มีอยู่ ถ้าตอนนั้น Edge ไม่ได้เชื่อมต่อกับสายรัด จะไม่มีอะไรเกิดขึ้น"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 Edge 现有的连接让手环振动一次。如果此时 Edge 未连接手环，则不会有任何反应。"
          }
        }
      }
    },
