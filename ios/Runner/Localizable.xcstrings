      }
    },
    "%@ is still finishing up. Ask again a little later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wird noch abgeschlossen. Frag gleich noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ todavía se está terminando. Vuelve a preguntar un poco más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est en cours de finalisation. Redemandez un peu plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अभी पूरा हो रहा है। थोड़ी देर बाद फिर पूछें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ещё рассчитывается. Спросите чуть позже."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ กำลังดำเนินการขั้นสุดท้าย ลองถามอีกครั้งในอีกสักครู่"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 即将完成，请稍后再问。"
          }
        }
      }
    },
    "%@ isn't scored yet. %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist noch nicht berechnet. %2$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ aún no tiene puntuación. %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ n'est pas encore évalué. %2$@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का स्कोर अभी नहीं बना है। %2$@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ещё не рассчитано. %2$@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ยังไม่มีคะแนน %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 尚未评分。%2$@"
          }
        }
      }
    },
    "Ask OpenStrap for today's recovery.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag OpenStrap nach deiner heutigen Erholung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a OpenStrap por tu recuperación de hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à OpenStrap votre récupération du jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenStrap से आज की रिकवरी पूछें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте у OpenStrap сегодняшнее восстановление."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม OpenStrap เรื่องการฟื้นตัวของวันนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 OpenStrap 查询今天的恢复。"
          }
        }
      }
    },
    "Ask OpenStrap for today's strain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag OpenStrap nach deinem heutigen Strain."
          }
        },
        "es": {
          "stringUnit": {
