    "I don't have today's numbers yet. Open OpenStrap and sync your band.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe die heutigen Werte noch nicht. Öffne OpenStrap und synchronisiere dein Band."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tengo los datos de hoy. Abre OpenStrap y sincroniza tu banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je n'ai pas encore les chiffres d'aujourd'hui. Ouvrez OpenStrap et synchronisez votre bracelet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरे पास आज के आँकड़े अभी नहीं हैं। OpenStrap खोलें और अपना बैंड सिंक करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У меня пока нет сегодняшних данных. Откройте OpenStrap и синхронизируйте браслет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มีตัวเลขของวันนี้ เปิด OpenStrap แล้วซิงค์สายรัดของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我还没有今天的数据。打开 OpenStrap 并同步你的手环。"
          }
        }
      }
    },
