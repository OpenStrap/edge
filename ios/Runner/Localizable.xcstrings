    "Open Edge and sync your paired band. Use this interactive action for catch-up that needs the app in front.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne Edge und synchronisiere dein gekoppeltes Band. Nutze diese interaktive Aktion zum Aufholen, wenn die App im Vordergrund sein muss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Edge y sincroniza tu banda emparejada. Usa esta acción interactiva para ponerte al día cuando la app tiene que estar en primer plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez Edge et synchronisez votre bracelet jumelé. Utilisez cette action interactive pour rattraper un retard qui demande l'application au premier plan."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Edge खोलें और अपना जुड़ा हुआ बैंड सिंक करें। जब ऐप सामने होना ज़रूरी हो, तब बकाया डेटा के लिए यह इंटरैक्टिव ऐक्शन इस्तेमाल करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте Edge и синхронизируйте сопряжённый браслет. Используйте это действие, когда для догрузки данных приложение должно быть на экране."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Edge แล้วซิงค์สายรัดที่จับคู่ไว้ ใช้การทำงานแบบโต้ตอบนี้เมื่อต้องการตามข้อมูลที่ค้างโดยให้แอปอยู่ด้านหน้า"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 Edge 并同步已配对的手环。需要应用在前台补同步时，使用这个交互操作。"
          }
        }
      }
    },
    "Recovery": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erholung"
          }
        },
        "es": {
