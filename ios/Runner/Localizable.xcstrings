{
  "sourceLanguage": "en",
  "strings": {
    "%@ is still calibrating, %@ so far.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ lernt noch deine üblichen Werte, bisher %2$@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ todavía se está calibrando: %2$@ por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ est encore en cours de calibrage : %2$@ pour l'instant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ अभी कैलिब्रेट हो रहा है, अब तक %2$@।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ещё калибруется, пока %2$@."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ยังอยู่ระหว่างปรับเทียบ ตอนนี้ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 仍在校准中，目前 %2$@。"
          }
        }
      }
    },
    "%@ is still calibrating.": {
      "localizations": {
        "de": {
          "stringUnit": {
