          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте у OpenStrap сегодняшнюю нагрузку."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ถาม OpenStrap เรื่องความหนักของวันนี้"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向 OpenStrap 查询今天的消耗。"
          }
        }
      }
    },
    "Ask OpenStrap how you slept.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frag OpenStrap, wie du geschlafen hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta a OpenStrap cómo dormiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez à OpenStrap comment vous avez dormi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenStrap से पूछें कि आप कैसे सोए।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнайте у OpenStrap, как вы спали."
