    "How long you slept, against the need the app has learned.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie lange du geschlafen hast, gemessen an dem Bedarf, den die App gelernt hat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuánto dormiste, frente a la necesidad que la app ha aprendido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de temps vous avez dormi, par rapport au besoin appris par l'application."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कितना सोए, ऐप द्वारा सीखी गई ज़रूरत की तुलना में।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сколько вы спали в сравнении с потребностью, которую выучило приложение."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณนอนนานเท่าไร เทียบกับความต้องการที่แอปเรียนรู้มา"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你睡了多久，对比应用学到的睡眠需求。"
          }
        }
      }
    },
