    "Last night's HRV against your own baseline, and resting heart rate.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die HRV der letzten Nacht im Vergleich zu deinem eigenen Basiswert, dazu der Ruhepuls."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La VFC de anoche frente a tu propia base, y la frecuencia cardiaca en reposo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La VFC de cette nuit par rapport à votre propre référence, et la fréquence cardiaque au repos."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछली रात का HRV आपके अपने आधार की तुलना में, और विश्राम हृदय गति।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ВСР прошлой ночи в сравнении с вашей базой и пульс в покое."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "HRV เมื่อคืนเทียบกับค่าฐานของคุณเอง และอัตราการเต้นหัวใจขณะพัก"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨晚的 HRV 与你自己的基线对比，以及静息心率。"
          }
        }
      }
    },
