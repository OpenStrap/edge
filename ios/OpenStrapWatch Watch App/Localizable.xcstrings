    "Open OpenStrap on your iPhone and sync your band.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne OpenStrap auf deinem iPhone und synchronisiere dein Band."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre OpenStrap en tu iPhone y sincroniza tu banda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez OpenStrap sur votre iPhone et synchronisez votre bracelet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर OpenStrap खोलें और अपना बैंड सिंक करें।"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте OpenStrap на iPhone и синхронизируйте браслет."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด OpenStrap บน iPhone แล้วซิงค์สายรัดของคุณ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 OpenStrap 并同步你的手环。"
